# Copy to .env for local dev. Never commit real secrets.

# ---- Core ----
ORDY_ENV=dev
ORDY_LOG_LEVEL=INFO

# ---- Database ----
# App role: NO BYPASSRLS. Migrations use a separate superuser/owner role.
DATABASE_URL=postgresql+asyncpg://ordy_app:ordy_app_pw@localhost:5432/ordy
DATABASE_MIGRATION_URL=postgresql+psycopg://ordy_migrator:ordy_migrator_pw@localhost:5432/ordy

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Object storage (MinIO in dev) ----
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=eu-west-1
S3_BUCKET=ordy-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ---- Auth / JWT ----
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me-please-0000000000000000000000000000
JWT_ACCESS_TTL_SECONDS=900          # 15 min
JWT_REFRESH_TTL_SECONDS=2592000     # 30 days
JWT_ISSUER=ordy

# ---- CORS / web ----
WEB_ORIGIN=http://localhost:3000

# ---- AI providers (used from Phase 3+) ----
OPENAI_API_KEY=
MODEL_ROUTER_CONFIG=config/model_router.yaml

# ---- Voice (Phase 5+) ----
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
